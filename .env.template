PORT=7123

GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ZAI_API_KEY=
# ZAI_BASE_URL=https://api.z.ai/api/anthropic
NVIDIA_API_KEY=

# Ollama (local LLM)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
# Context window in tokens (default: 8192). Ollama's own default is 4096 and it
# truncates the oldest tokens - which is where the system prompt sits.
# OLLAMA_NUM_CTX=8192
# How long Ollama keeps the model in RAM after a request ("30m", "-1" forever,
# "0" unload now). A cold load is the bulk of the time-to-first-token, so a warm
# model is what keeps Ollama inside the router probe budget below.
# OLLAMA_KEEP_ALIVE=30m

# Models whose chat template has no real `system` role (comma-separated name
# fragments, matched case-insensitively). For these, system messages are merged
# into the first user turn behind explicit delimiters. Defaults to `gemma`;
# set it empty to disable the adaptation.
# MODELS_WITHOUT_SYSTEM_ROLE=gemma

# How long the router waits for a provider's first chunk (dial included) before
# moving on to the next one. Default 3000ms.
# FIRST_CHUNK_TIMEOUT_MS=3000
# Per-provider override: FIRST_CHUNK_TIMEOUT_MS_<PROVIDER>. A local Ollama may
# need to load the model before answering, so it needs a much larger budget than
# a hosted API - but keep it below the client's own timeout, or the client gives
# up first and the whole request is cancelled.
# FIRST_CHUNK_TIMEOUT_MS_OLLAMA=30000

# Models configuration (optional, overrides models.json)
# JSON string with provider model configs. If not set, models.json is used.
# MODELS_CONFIG={"cerebras":{"default":"qwen-3-32b","enableFallback":true,"models":["qwen-3-32b"]},"groq":{"default":"llama-3.3-70b-versatile","enableFallback":true,"models":["llama-3.3-70b-versatile"]},"zai":{"default":"glm-4.7","enableFallback":true,"models":["glm-4.7"]}}

# https://console.groq.com/
# https://cloud.cerebras.ai/
# https://openrouter.ai/qwen/qwen3-coder:free
# https://aistudio.google.com/app/api-keys
# https://ollama.com/
# https://build.nvidia.com/